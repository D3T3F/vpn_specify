// Template of the Windows resources (icon and version info) of the
// executables. scripts\build.ps1 -Icon fills in the {{FIELDS}} and writes the
// rsrc_windows_amd64.syso files of cmd\vpn_specify and cmd\installer.
#pragma code_page(65001)
1 ICON "vpn_specify.ico"

1 VERSIONINFO
FILEVERSION {{VERSION_COMMA}}
PRODUCTVERSION {{VERSION_COMMA}}
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "{{DESCRIPTION}}"
      VALUE "ProductName", "vpn_specify"
      VALUE "FileVersion", "{{VERSION}}"
      VALUE "ProductVersion", "{{VERSION}}"
      VALUE "OriginalFilename", "{{FILENAME}}"
      VALUE "LegalCopyright", "Copyright (c) 2026 D3T3F. MIT License."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
