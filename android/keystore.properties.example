# Copy to keystore.properties (ignored by git) to sign release builds.
# Create the key once, with:
#   keytool -genkeypair -v -keystore vpn_specify-release.keystore -alias vpn_specify -keyalg RSA -keysize 4096 -validity 36500
# Keep the keystore and its password safe and backed up: an update must be
# signed with the same key, or Android refuses to install it over the old one.
storeFile=vpn_specify-release.keystore
storePassword=CHANGE_ME
keyAlias=vpn_specify
keyPassword=CHANGE_ME
